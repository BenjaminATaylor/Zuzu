process.container = 'benjaminataylor/zuzu:latest'
docker.enabled = true

params {
    // Initial SVC-RFECV defaults; users may override these for fixed-parameter runs
    svc_c = 1.0
    svc_class_weight = 'balanced'
    svc_scoring = 'balanced_accuracy'
    svc_folds = 5
    svc_seed = 1729
    stepsize = 50
    njobs = 1
}

process {
    withLabel: small_job {
        cpus = 1
        memory = '1 GB'
        time = '5m'
    }
    withLabel: mid_job {
        cpus = 1
        memory = '5 GB'
        time = '1h'
    }
    withLabel: big_job {
        cpus = 10
        memory = '20 GB'
        time = '1d'
    }
}

profiles {
    local {
        params.njobs = 1
    }
    cluster {
        params.njobs = -1
        process {
            withLabel: big_job {
                memory = '30 GB'
            }
        }
    }
}
