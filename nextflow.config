process.container = 'benjaminataylor/zuzu:latest'
docker.enabled = true

params {
    // Provisional stability-selected elastic-net defaults; this branch is opt-in
    enet_alpha = 0.25
    enet_pairs = 50
    enet_pi = 0.90
    enet_folds = 5
    enet_nlambda = 100
    enet_lambda_min_ratio = 0.001
    enet_seed = 45217

    // Initial SVC RFE-CV defaults; users may override these for fixed-parameter runs
    svc_c = 1.0
    svc_class_weight = 'balanced'
    svc_scoring = 'balanced_accuracy'
    svc_folds = 5
    svc_seed = 1729
    svc_coarse_grid = '1,2,3,5,8,13,20,32,50,80,125,200,320,500,800,1250,2000,3200,5000,8000,10000'
    svc_refinement_points = 8
    svc_gate_permutations = 99
    svc_gate_alpha = 0.05
    svc_gate_seed = 2718
    svc_gate_early_stop = true
    // Retained for dormant legacy SVM modules that still use fixed-step elimination
    stepsize = 50
    njobs = 1
}

process {
    withLabel: small_job {
        cpus = 1
        memory = '1 GB'
        time = '5m'
    }
    withLabel: mid_job {
        cpus = 1
        memory = '5 GB'
        time = '1h'
    }
    withLabel: big_job {
        cpus = 10
        memory = '20 GB'
        time = '1d'
    }
}

profiles {
    local {
        params.njobs = 1
    }
    cluster {
        params.njobs = -1
        process {
            withLabel: big_job {
                memory = '30 GB'
            }
        }
    }
}
